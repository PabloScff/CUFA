# Copie para .env (nunca versionar o .env). Gere o segredo com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-48-caracteres-ou-mais
JWT_EXPIRA_MINUTOS=480

# Desenvolvimento local (SQLite). Em produção use o PostgreSQL gerenciado (Supabase/Neon):
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_URL=sqlite:///./creamshaper.db

# Ciclo de campanha ativo (identificador gravado em entregas.ciclo_campanha) e rótulo exibido na Tela 2
CICLO_ID=2026-FSET-01
CICLO_ROTULO=Ciclo 01/2026

# true em produção (HTTPS): o cookie da sessão só trafega por HTTPS
COOKIE_SECURE=false

# Anti força bruta no login
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_SEGUNDOS=300
